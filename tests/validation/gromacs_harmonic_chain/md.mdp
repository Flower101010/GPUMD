integrator              = md-vv
dt                      = 0.00005
nsteps                  = 2000

continuation            = yes
constraints             = none
gen-vel                 = no
comm-mode               = none
tcoupl                  = no
pcoupl                  = no

cutoff-scheme           = Verlet
nstlist                 = 10
rlist                   = 1.0
coulombtype             = Cut-off
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
pbc                     = xyz

nstcalcenergy           = 20
nstenergy               = 20
nstlog                  = 0
nstxout                 = 20
nstvout                 = 0
nstfout                 = 0
nstxout-compressed      = 0
